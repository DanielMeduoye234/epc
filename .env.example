# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron (required in production). Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# WhatsApp Cloud API. One access token can send from several numbers in the same WABA.
# Per-branch Phone Number IDs are stored in Settings (whatsapp_phone_number_id).
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Google Calendar (EPC Guide counselling bookings)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIME_ZONE=Africa/Accra
GOOGLE_WORKSPACE_IMPERSONATE_EMAIL=
COUNSELLING_SESSION_MINUTES=30

# Everything by Prayer Assistant (optional). Without a key, the assistant still answers from
# built-in guides and live branch data. With a key, answers become conversational.
# Use one of:
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ASSISTANT_MODEL=
